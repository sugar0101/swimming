{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "target": "es2022",
    "baseUrl": "src",
    "resolveJsonModule": true,
    "paths": {
      "src/*": ["src/*"]
    }
  },
  "compileOnSave": true,
  "include": ["src", "src/**/*.json", "src/**/*.ts"]
}
