# Copia este archivo a .env.local y ajusta los valores.
FUNCTIONS_ENDPOINT=http://localhost:5001/swimming-639f1/us-central1
# true: en `quasar dev` la autenticacion usa el emulador (puerto 9099).
USE_AUTH_EMULATOR=true
FIREBASE_EMULATOR_SUITE_URL=http://localhost:4000
LOCALHOST=localhost

# URL publica del APK (Drive, GitHub Releases...). Vacio = /downloads/swimming.apk del hosting (solo plan Blaze).
APK_URL=
