{
  "name": "swimming",
  "version": "0.0.1",
  "productName": "swimming",
  "description": "Swimming is Cool · Training Center: control de alumnos y mensualidades.",
  "author": "ccencisoj@gmail.com",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "quasar prepare",
    "lint": "eslint --ext .js,.ts,.vue ./",
    "lint:ci": "eslint --ext .js,.ts,.vue ./ --max-warnings 0",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier \"**/*.{js,ts,vue,scss,html,md,json}\" --check --ignore-path .gitignore",
    "test": "vitest",
    "dev": "npx dotenvx run -f .env.local -- quasar dev",
    "build": "quasar build",
    "deploy": "npm run build && cd .. && firebase deploy --only hosting --project swimming-639f1",
    "deploy-staging": "quasar build && cd .. && firebase hosting:channel:deploy staging --project swimming-639f1"
  },
  "dependencies": {
    "@optimize-lodash/rollup-plugin": "^6.0.0",
    "@quasar/extras": "^1.16.12",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.2.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "firebase": "^10.14.1",
    "lodash": "^4.17.21",
    "pinia": "^2.0.11",
    "quasar": "^2.24.0",
    "vue": "^3.4.38",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.4.3",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.39.0",
    "@quasar/app-vite": "~2.4.1",
    "@types/lodash": "^4.14.201",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.10.0",
    "@typescript-eslint/parser": "^5.10.0",
    "autoprefixer": "^10.4.2",
    "eslint": "^8.10.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-vue": "^9.0.0",
    "prettier": "^2.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": "^22 || >=24",
    "npm": ">= 6.13.4"
  }
}
