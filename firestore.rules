rules_version = '2';

// Reglas de swimming.
// - Las Cloud Functions usan Admin SDK y NO pasan por aquí.
// - Todo cerrado por defecto; se abre colección por colección.
// - La app la usa el equipo de la escuela con sesión iniciada: alumnos y
//   pagos requieren usuario autenticado.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Perfil/autorización del usuario: solo el propio usuario lo lee.
    // La escritura la hacen las functions (Admin SDK).
    match /authorization/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /{document=**} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    // Alumnos y sus mensualidades.
    match /students/{studentId} {
      allow read, write: if signedIn();
    }

    // El delete permite corregir un cobro registrado por error.
    match /payments/{paymentId} {
      allow read, create, delete: if signedIn();
      allow update: if false;
    }

    // Pagos del servicio de piscina (gasto del mes).
    match /poolPayments/{paymentId} {
      allow read, create, delete: if signedIn();
      allow update: if false;
    }

    // Todo lo demás: cerrado hasta que exista un modelo que lo necesite.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
